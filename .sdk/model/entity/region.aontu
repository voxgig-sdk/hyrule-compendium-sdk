# Entity: region

main: kit: entity: region: {

  alias: field: {}

  fields: [
    {
      name: "data"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "region"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/regions"
          parts: [
            "regions"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "hyrule_field"
                kind: "param"
                name: "id"
                orig: "region"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/region/{region}"
          parts: [
            "region"
            "{id}"
          ]
          rename: {
            param: {
              region: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
