# Entity: master_mode

main: kit: entity: master_mode: {

  alias: field: {}

  fields: [
    {
      name: "category"
      req: true
      short: "Category of the entry"
      type: "`$STRING`"
    }
    {
      name: "common_locations"
      req: false
      short: "Common locations where this entry can be found"
      type: "`$ARRAY`"
    }
    {
      name: "cooking_effect"
      req: false
      short: "Cooking effect for food/material entries"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Detailed description of the entry"
      type: "`$STRING`"
    }
    {
      name: "dlc"
      req: false
      short: "Whether this entry is part of DLC content"
      type: "`$BOOLEAN`"
    }
    {
      name: "drops"
      req: false
      short: "Items that can be dropped by this entry"
      type: "`$ARRAY`"
    }
    {
      name: "edible"
      req: false
      short: "Whether this item is edible"
      type: "`$BOOLEAN`"
    }
    {
      name: "hearts_recovered"
      req: false
      short: "Hearts recovered when consuming this item"
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier for the entry"
      type: "`$INTEGER`"
    }
    {
      name: "image"
      req: false
      short: "URL to the entry's image"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "Name of the entry"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "master_mode"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "entry"
                orig: "entry"
                reqd: true
                type: "`$ANY`"
              }
            ]
          }
          method: "GET"
          orig: "/master_mode/entry/{entry}"
          parts: [
            "master_mode"
            "entry"
            "{entry}"
          ]
          select: {
            exist: [
              "entry"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "entry"
      ]
    ]
  }



}
