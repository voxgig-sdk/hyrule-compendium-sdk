# Guide

guide: {
  metrics: count: entity: 4
  metrics: count: path: 7
  metrics: count: method: 7

  entity: category: {
    path: "/category/{category}": {
      rename: param: "category": *"id"
      op: load: method: *GET
    }
  }

  entity: compendium_entry: {
    path: "/all": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/entry/{entry}": {
      rename: param: "entry": *"id"
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/entry/{entry}/image": {
      rename: param: "entry": *"entry_id"
      op: load: method: *GET
    }
  }

  entity: master_mode: {
    path: "/master_mode/entry/{entry}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
  }

  entity: region: {
    path: "/region/{region}": {
      rename: param: "region": *"id"
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/regions": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
  }

}